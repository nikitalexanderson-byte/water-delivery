# Локальные значения для синтетических данных. Скопировать в .env.
API_HOST=127.0.0.1
API_PORT=8080
BUSINESS_TZ=Europe/Moscow
SEED_DEMO=true
DEMO_PASSWORD=local-farvater-19
BASE_ADDRESS=
BASE_LAT=
BASE_LON=
# Без DATABASE_URL и PGHOST база хранится вне рабочей папки в локальном профиле.
LOCAL_DB_DIR=
# При отдельном сервере PostgreSQL задайте DATABASE_URL либо стандартные PG*.
DATABASE_URL=
POSTGRES_DB=farvater
POSTGRES_USER=farvater
POSTGRES_PASSWORD=local-database-only
MAP_PROVIDER=demo
# Уличная карта OpenStreetMap. Для автономного режима укажите false.
MAP_TILES_ENABLED=true
# Поиск адреса по кнопке. Для собственного Photon укажите его endpoint /api/.
GEOCODER_ENABLED=true
GEOCODER_URL=https://photon.komoot.io/api/
GEOCODER_MIN_INTERVAL_MS=1000
GEOCODER_TIMEOUT_MS=5000
# Дорожный путь по порядку остановок. Для своего OSRM: http://localhost:5000/
ROAD_ROUTER_ENABLED=true
ROAD_ROUTER_URL=https://routing.openstreetmap.de/routed-car/
ROAD_ROUTER_MIN_INTERVAL_MS=1100
ROAD_ROUTER_TIMEOUT_MS=8000
ROAD_ROUTER_SNAP_METERS=250
DEMO_LEG_MINUTES=15
STOP_BASE_MINUTES=8
STOP_PER_BOTTLE_MINUTES=0.7
RELOAD_MINUTES=20
FLOOR_MINUTES=2
CHECKPOINT_MINUTES=5
LOADER_FACTOR=0.75
CART_FACTOR=0.8
# Коэффициент дорожного времени учитывает ожидаемую загруженность.
TRAFFIC_FACTOR=1
# При известной паре координат без кэшированного участка OSRM.
ESTIMATED_SPEED_KMH=28
ESTIMATED_ROAD_FACTOR=1.4
DEMO_WATER_PRICE_KOP=35000
SESSION_HOURS=12
# Выгрузка новых отчётов в выделенный лист Google Таблиц.
SHEETS_EXPORT_ENABLED=false
SHEETS_TEAM_ID=1
SHEETS_SPREADSHEET_ID=
SHEETS_TAB="ФАРВАТЕР — смены"
SHEETS_CLIENT_EMAIL=
SHEETS_PRIVATE_KEY=
REGISTRATION_ENABLED=true
