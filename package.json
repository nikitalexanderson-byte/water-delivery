{
  "name": "farvater",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env apps/api/src/server.js",
    "test": "node --test apps/api/test/*.test.js",
    "build": "npm run build -w apps/web",
    "dev": "npm run dev -w apps/web",
    "test:web": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2"
  }
}
