{$SITE_ADDRESS} {
	encode zstd gzip
	header {
		X-Frame-Options SAMEORIGIN
		Permissions-Policy "geolocation=(self)"
		-Server
	}
	@androidApk path /downloads/wayslate.apk /downloads/farvater-driver.apk
	handle @androidApk {
		# Previously installed apps download directly from the legacy URL.
		rewrite * /downloads/farvater-driver.apk
		root * /srv
		header Content-Type application/vnd.android.package-archive
		header Content-Disposition "attachment; filename=wayslate.apk"
		header Cache-Control "no-cache"
		file_server
	}
	handle {
		reverse_proxy api:8080
	}
}
